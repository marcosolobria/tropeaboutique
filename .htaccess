DirectoryIndex index.html index.htm

Options -Indexes

# Bloquea acceso web directo a archivos de configuración/secretos
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

RewriteEngine On

# www → sin www (para LiteSpeed)
RewriteCond %{HTTP_HOST} ^www\.tropeaboutique\.com$ [NC]
RewriteRule ^ https://tropeaboutique.com%{REQUEST_URI} [R=301,L]

# http → https
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^tropeaboutique\.com$ [NC]
RewriteRule ^ https://tropeaboutique.com%{REQUEST_URI} [R=301,L]

# HTML nunca en caché
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</FilesMatch>

# SVG y assets con caché corta (1 semana, no 1 año)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType application/json "access plus 1 day"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
